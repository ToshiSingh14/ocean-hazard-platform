# ==============================================================================
# Ocean Hazard Platform - Backend Environment Variables
# ==============================================================================
# Copy this file to .env and configure your environment-specific settings.
# Do not commit real production credentials to version control.

# Server Port
PORT=5000

# Runtime Environment (development | production | test)
NODE_ENV=development

# MongoDB Connection URI
# Local instance default: mongodb://127.0.0.1:27017/ocean_hazard_db
# MongoDB Atlas example: mongodb+srv://<username>:<password>@cluster0.mongodb.net/ocean_hazard_db?retryWrites=true&w=majority
MONGO_URI=mongodb://127.0.0.1:27017/ocean_hazard_db

# Frontend Client URL for CORS
CLIENT_ORIGIN=http://localhost:5173

# Python NLP Microservice Endpoint
NLP_SERVICE_URL=http://localhost:8000
